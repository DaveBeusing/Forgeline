<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Preserve exact zero-allocation checks despite background-GC counter
         accounting in .NET 10 (dotnet/runtime#134724 and #134855). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <ProjectReference Include="../../src/ForgeLine.Presentation/ForgeLine.Presentation.csproj" />
    <ProjectReference Include="../../src/ForgeLine.Input/ForgeLine.Input.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/command-dock-geometry.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
