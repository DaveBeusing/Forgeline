{
  "schema": "forgeline.directorate.conveyor_visual_kit",
  "schemaVersion": 1,
  "status": "design_baseline_proposed_for_pr_review_not_compiled",
  "engine": {
    "units": "meters",
    "upAxis": "+Y",
    "forwardAxis": "+Z",
    "rightAxis": "+X",
    "pivot": "origin at module ground reference; tier transforms add whole 2m steps",
    "cardinalRotationDegrees": [
      0,
      90,
      180,
      270
    ]
  },
  "geometry": {
    "gridMeters": 4,
    "shortLengthMeters": 4,
    "standardLengthMeters": 8,
    "transportSurfaceWidthMeters": 2,
    "outerAssemblyWidthMeters": 2.8,
    "beltSurfaceYTierZeroMeters": 5.8,
    "assemblyUndersideYTierZeroMeters": 5.2,
    "railTopYTierZeroMeters": 6.3,
    "roadPassageMinimumMeters": 5,
    "roadPassageDesignMarginMeters": 0.2,
    "elevationTierStepMeters": 2,
    "curveCenterlineRadiusMeters": 4,
    "portPositionToleranceMeters": 0.02,
    "portAngleToleranceDegrees": 1,
    "modulesWithoutGroundContact": true,
    "supportsHaveGroundContact": true,
    "defaultModuleYawDegrees": 0,
    "normalizedSourceScale": 1
  },
  "flow": {
    "beltResources": [
      "ferrous_ore",
      "silicates",
      "steel",
      "electronics",
      "ammunition"
    ],
    "ineligibleFamilies": [
      "fuel",
      "volatiles",
      "liquids",
      "gases",
      "units",
      "vehicles"
    ],
    "sourceOfTruth": "docs/BaseConveyorLogistics.md; docs/BaseConveyorPortMatrix.md",
    "topologySemantics": "future, no gameplay logic in this kit"
  },
  "materials": {
    "palette": {
      "paintedArmorSteel": {
        "baseColorHex": "#404A43",
        "metallic": 0,
        "roughness": 0.72
      },
      "exposedStructuralSteel": {
        "baseColorHex": "#5F6868",
        "metallic": 0.88,
        "roughness": 0.56
      },
      "darkGunmetal": {
        "baseColorHex": "#282D30",
        "metallic": 0.85,
        "roughness": 0.65
      },
      "rubberBelt": {
        "baseColorHex": "#202428",
        "metallic": 0,
        "roughness": 0.94
      },
      "reinforcedConcrete": {
        "baseColorHex": "#666762",
        "metallic": 0,
        "roughness": 0.91
      },
      "warningPaint": {
        "baseColorHex": "#B78432",
        "metallic": 0,
        "roughness": 0.78
      }
    },
    "pbr": "BaseColor, Normal and ORM (AO/Roughness/Metallic), separate small emissive channel for powered controls",
    "reusedAtlas": "assets/source/materials/directorate/surfaces",
    "uniqueTexturesRequired": false,
    "factionColorMaximumSurfaceFraction": 0.08,
    "blueprints": {
      "direction": "painted asymmetric chevrons and exposed roller intervals; never faction color alone",
      "state": "physical shutters, rollers and status lamps; never hue alone"
    }
  },
  "states": [
    {
      "id": "flowing",
      "cue": "rollers and belt UV advance; small transfer-gate lamps; moving aggregate cargo optional",
      "movement": true,
      "overlayLabel": "FLOWING"
    },
    {
      "id": "idle_no_input",
      "cue": "static rollers; open feed hopper visible and empty; sparse dormant white control light",
      "movement": false,
      "overlayLabel": "NO INPUT"
    },
    {
      "id": "disconnected",
      "cue": "open connector jaw and mechanical stop bar; no flowing particles",
      "movement": false,
      "overlayLabel": "DISCONNECTED"
    },
    {
      "id": "congested",
      "cue": "visible packed loads with transfer stop/stack; amber alternating load indicator",
      "movement": false,
      "overlayLabel": "CONGESTED"
    },
    {
      "id": "blocked",
      "cue": "closed physical shutter across output, striped hazard guard and blinking amber lamp",
      "movement": false,
      "overlayLabel": "BLOCKED"
    },
    {
      "id": "unpowered",
      "cue": "stationary rollers and extinguished drive, mechanical brake engagement",
      "movement": false,
      "overlayLabel": "UNPOWERED"
    },
    {
      "id": "damaged",
      "cue": "bent guard or separated outer plate, a few sparks; transport logic external",
      "movement": "conditional",
      "overlayLabel": "DAMAGED"
    },
    {
      "id": "critical",
      "cue": "one broken bearer and localized smoke/sparks while still recognizable",
      "movement": "conditional",
      "overlayLabel": "CRITICAL"
    },
    {
      "id": "destroyed",
      "cue": "collapsed localized span, separated belt path and solid silhouette blockage",
      "movement": false,
      "overlayLabel": "DESTROYED"
    }
  ],
  "visualBudget": {
    "normalCameraPriority": [
      "direction",
      "junction_role",
      "clearance",
      "operating_state",
      "faction",
      "fine_detail"
    ],
    "recommendedLODs": [
      "lod0",
      "lod1",
      "lod2"
    ],
    "instanceReuse": "repeat straight beam/roller/support, share material families",
    "vfxCost": "no per-item physics; animate aggregate belt material only"
