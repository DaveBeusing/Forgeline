
# Generated metrics are hashed and verified byte-for-byte on every platform.
assets/source/ui/fonts/metrics.json text eol=lf
assets/source/ui/fonts/*.ttf binary
assets/source/ui/fonts/*.gz binary
assets/source/ui/fonts/*.png binary

# Editable vector identities must match the Git blobs on every checkout.
assets/source/ui/directorate/**/*.svg text eol=lf
docs/qualification/directorate-ui-artwork/*.csv text eol=lf
docs/qualification/directorate-ui-artwork/**/*.json text eol=lf
docs/qualification/directorate-ui-artwork/terrain/native-manifest.json -text
assets/source/ui/directorate/atlas/*.json text eol=lf

docs/qualification/directorate-ui-atlas/*.json text eol=lf
docs/qualification/directorate-ui-atlas/native-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/qualification/directorate-ui-atlas/packaged-*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Immutable native qualification records keep their original byte hashes.
docs/qualification/graphical-frontend/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/qualification/graphical-frontend/*.log -text -whitespace
docs/qualification/graphical-frontend/evidence.json text eol=lf

# Immutable battlefield qualification records preserve original bytes.
docs/qualification/graphical-battlefield/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/qualification/graphical-battlefield/evidence.json text eol=lf

docs/qualification/graphical-operations/evidence.json text eol=lf

docs/qualification/graphical-tactical/evidence.json text eol=lf
docs/qualification/graphical-tactical/*.png binary
docs/qualification/graphical-tactical/*.zip binary

# Preserve native skeletal qualification identities and original image hashes.
docs/review/infantry-skin/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
